# Brewfather -> Settings -> API. Generate a key with the "Read Batches" scope.
BREWFATHER_USER_ID=
BREWFATHER_API_KEY=

# Port the web server listens on.
PORT=3000

# Optional. URL the Chromecast should load. Leave blank to auto-detect your LAN IP.
# Example: http://192.168.1.50:3000/
PUBLIC_URL=

# Optional. Which Brewfather batch statuses to offer in the admin page.
# Fermenting batches can be put on a tap early; they show as "Coming soon" until kegged.
BREWFATHER_STATUSES=Fermenting,Conditioning,Completed

# Optional. Minutes to cache Brewfather responses (API limit is 500 calls/hour).
BREWFATHER_CACHE_MINUTES=10

# Optional. Set to true to cast to the default TV automatically when the server starts.
CAST_ON_START=false

# Optional. Publish the tap list as a JSON file in a GitHub repo, so a static
# website (GitHub Pages) can show what's on tap. Make a fine-grained personal
# access token at https://github.com/settings/personal-access-tokens/new with
# access to only that repo and "Contents: Read and write". It publishes a few
# seconds after you save taps or custom items, and every PUBLISH_EVERY_HOURS.
PUBLISH_GITHUB_TOKEN=
PUBLISH_REPO=owner/repo
PUBLISH_PATH=taps.json
PUBLISH_BRANCH=main
PUBLISH_EVERY_HOURS=24
